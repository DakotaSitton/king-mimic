{
  "name": "king-mimic",
  "version": "0.0.1",
  "private": true,
  "description": "Browser co-op deckbuilder roguelike. Wear the bodies of the foes you defeat.",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch server.js",
    "start": "bun run server.js",
    "test": "bun run test/game.test.js && bun run test/onboarding.test.js && bun run test/card-expansion.test.js && bun run test/card-art.test.js && bun run test/card-animation.test.js && bun run test/combat-graphics.test.js && bun run test/baber-summons.test.js && bun run test/clock.test.js",
    "test:passives": "bun run test/body-passives.test.js",
    "test:fuzz": "bun run test/fuzz.js",
    "test:serve": "bun run test/serve.test.js",
    "test:mobile-map": "node test/mobile-map-interaction.test.js",
    "test:symmetry": "bun run test/symmetry.test.js",
    "test:entry": "bun run test/public-entry.test.js",
    "test:persistence": "bun run test/run-persistence.test.js",
    "test:telemetry-report": "bun run test/telemetry-report.test.js",
    "test:owner-lab": "bun run test/owner-lab.test.js",
    "test:itch": "bun run test/itch-package.test.js",
    "test:smoke": "bun run test/smoke.js",
    "test:e2e": "bun run test/e2e.js",
    "shots": "node tools/shoot.mjs",
    "build:dungeon": "bun build ./node_modules/three/build/three.module.js --target browser --minify --outfile public/vendor/three.js",
    "test:dungeon": "node test/dungeon-ui.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  },
  "dependencies": {
    "three": "0.185.1"
  }
}
